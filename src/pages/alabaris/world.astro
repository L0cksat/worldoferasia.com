---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection  } from 'astro:content';

const corporations = await getCollection('corporations')
const diaries = await getCollection('diaries')
---

<BaseLayout
	title="World of Alabaris - World"
	description="Lore and world information for Alabaris."
	navVariant="alabaris"
>
	<article class="worldText">
		<h1>The World of Alabaris</h1>
		<h3>Fortress Atoria Diaries</h3>
		<div class="scrollcontainer">
			{
				diaries.map((diary) => (
					<a href={`/alabaris/diaries/${diary.id}`} class="scrollbox-link">
						<div class="scrollbox">
							{diary.data.image && (
								<img 
								src={diary.data.image} 
								alt={diary.data.title} 
								class="scrollimage"
								/>
							)}
						</div>
						<div class="scrolldetails">
							<h4>{diary.data.title}</h4>
						</div>
					</a>
				))
			}
		</div>
		<h3 class="worldheader3">Corporations</h3>
		<div class="scrollcontainer">
			{
				corporations.map((corporation) => (
					<a href={`/alabaris/corporations/${corporation.id}`}>
						<div class="scrollbox">
							{corporation.data.image && (
								<img 
									src={corporation.data.image} 
									alt={`${corporation.data.name} emblem`}
									class="scrollimage"
								/>
							)}
							<div class="scrolldetails">
								<h4>{corporation.data.name}</h4>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</article>
</BaseLayout>
