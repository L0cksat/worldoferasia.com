---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="World of Alabaris"
	description="Enter the World of Alabaris campaign hub."
	navVariant="alabaris"
>
	<article class="home-article">
		<h1>World of Alabaris</h1>

		<figure class="home-campaign-frame campaign-landing-hero">
			<img
				src="/img/The Auric Horizon Team 2.webp"
				alt="The heroes of Alabaris — Auric Horizon"
			/>
			<figcaption>World of Alabaris</figcaption>
		</figure>

		<p class="mainPara">
			Welcome to the Alabaris campaign hub. World lore, characters, and sessions for this
			campaign will live here.
		</p>
		<p class="mainPara">
			Use the navigation above — content pages are ready as placeholders while the campaign
			is prepared.
		</p>
	</article>
</BaseLayout>
