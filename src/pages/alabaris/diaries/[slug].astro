---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const diaries = await getCollection("diaries");

  return diaries.map((diary) => ({
    params: { slug: diary.id },
    props: { diary },
  }));
}

interface Props {
  diary: CollectionEntry<"diaries">;
}

const { diary } = Astro.props;
const { Content } = await render(diary);
---

<BaseLayout
  title={`${diary.data.title} | World of Alabaris`}
  description={`Corporation details: ${diary.data.title}`}
  navVariant="alabaris"
>
  <article class="character-profile">
    <h1>{diary.data.title}</h1>
    {
      diary.data.image && (
        <div class="profile-image">
          <img src={diary.data.image} alt={diary.data.title} />
        </div>
      )
    }
    <h3>{diary.data.date}</h3>

    <div class="character-body scroll-body">
      <Content />
    </div>

    <p class="mainPara">
      <a href="/alabaris/world">← Back to World</a>
    </p>

  </article>
</BaseLayout>
