---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="World of Erasia"
	description="Enter the World of Erasia campaign hub."
	navVariant="erasia"
>
	<article class="home-article">
		<h1>World of Erasia</h1>

		<figure class="home-campaign-frame campaign-landing-hero">
			<img src="/img/The Heroes 3.webp" alt="The heroes of Erasia" />
			<figcaption>World of Erasia</figcaption>
		</figure>

		<p class="mainPara">
			Welcome to the Erasia campaign hub. From here you can explore the world's lore, meet
			the player characters, and listen to recorded sessions.
		</p>
		<p class="mainPara">
			Use the navigation above for <i>World</i>, <i>Characters</i>, and <i>Sessions</i>.
		</p>
	</article>
</BaseLayout>
